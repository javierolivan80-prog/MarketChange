# Copia a .env.local para desarrollo local. En Vercel: Project Settings -> Environment Variables.
# Misma URL que usa el pipeline de Python (ver ../RUNBOOK.md).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Opcional: acceso privado al panel (HTTP Basic Auth, ver middleware.ts).
# Si se dejan vacías, el panel es público para cualquiera con la URL.
DASHBOARD_USER=
DASHBOARD_PASSWORD=
